DATABASE_URL=postgres://guildhall:guildhall@localhost:5432/guildhall
APP_URL=http://localhost:3000

# GitHub App (see docs/github-app.md). Leave blank to run with dev login only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM contents; literal "\n" sequences are converted to newlines.
GITHUB_APP_PRIVATE_KEY=

# Local development only: enables /login "continue as" without GitHub. Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true

# Payments: Stripe Connect. Leave blank and set ENABLE_DEV_PAYMENTS=true to simulate locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_DEV_PAYMENTS=true

# Hourly cron for weekly automations: GET /api/cron/automations with Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Optional AI (automation drafting, meeting recaps). Uses claude-opus-5 unless GUILDHALL_AI_MODEL is set.
ANTHROPIC_API_KEY=

# Huddles (C5): WebRTC ICE servers as JSON. Defaults to Google's public STUN server, which is
# enough on most networks; add a TURN server (e.g. coturn) for people behind strict NATs:
# HUDDLE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Weekly digest email (C16, optional). Without these, digests are in-app only.
# RESEND_API_KEY=
# EMAIL_FROM="Guildhall <digest@yourdomain.com>"

# Discord slash commands (C21, optional; see docs/discord.md). Channel mirroring needs no setup.
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=

# Analytics (C23): secret salt for daily visitor hashes. Set it so unique counts survive restarts.
# ANALYTICS_SALT=
